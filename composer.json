{
  "name": "wonderwp/wonderwp",
  "description": "WonderWP Framework. A framework bringing modern and industrial development capabilities to WordPress",
  "type": "library",
  "keywords": ["WonderWp","WordPress","Framework"],
  "homepage": "http://wonderwp.net",
  "license": "MIT",
  "authors": [
    {
      "name": "Jeremy Desvaux",
      "homepage": "https://jdmweb.com"
    },
    {
      "name": "WonderWp Community",
      "homepage": "http://wonderwp.net/Contribution/Contributors.html"
    }
  ],
  "require": {
    "php": ">=8.0",
    "wonderwp/api": "dev-feature/php_8",
    "wonderwp/asset": "dev-feature/php_8",
    "wonderwp/autoload-wwp": "dev-feature/php_8",
    "wonderwp/block-bindings-source": "dev-feature/definition",
    "wonderwp/block-style": "dev-feature/definition",
    "wonderwp/block-type": "dev-feature/blocktype_definition",
    "wonderwp/block-variations": "dev-feature/definition",
    "wonderwp/cache": "dev-feature/php_8",
    "wonderwp/customposttype": "dev-feature/php_8",
    "wonderwp/custom-fields": "dev-feature/php8",
    "wonderwp/dependency-injection": "dev-feature/php_8",
    "wonderwp/filter": "dev-feature/php_8",
    "wonderwp/form": "dev-feature/increase_validation_lib_version",
    "wonderwp/functions": "dev-feature/php_8",
    "wonderwp/generator-wwp": "dev-feature/php_8",
    "wonderwp/hook": "dev-feature/php_8",
    "wonderwp/http": "dev-feature/php_8",
    "wonderwp/http-foundation": "dev-feature/increase_http_foundation_lib_version",
    "wonderwp/logging": "dev-feature/php_8",
    "wonderwp/mailing": "dev-feature/php_8",
    "wonderwp/media": "dev-feature/php_8",
    "wonderwp/notification": "dev-feature/php_8",
    "wonderwp/panel": "dev-feature/php_8",
    "wonderwp/plugin-skeleton": "dev-feature/php_8",
    "wonderwp/repository": "dev-feature/php_8",
    "wonderwp/response": "dev-feature/php8",
    "wonderwp/routing": "dev-feature/php_8",
    "wonderwp/sanitizer": "dev-feature/php_8",
    "wonderwp/search": "dev-feature/php_8",
    "wonderwp/service": "dev-feature/php_8",
    "wonderwp/shortcode": "dev-feature/php_8",
    "wonderwp/task": "dev-feature/php_8",
    "wonderwp/taxonomy": "dev-feature/php8",
    "wonderwp/template": "dev-feature/php_8"
  },
  "autoload": {
    "psr-4": {
      "WonderWp\\Bundle\\": "src"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^5.1",
    "johnpbloch/wordpress": "^6.0"
  }
}
